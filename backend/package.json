{
  "name": "@rush/backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:init": "tsx src/scripts/dbInit.ts",
    "db:reset": "tsx src/scripts/dbInit.ts --reset",
    "db:migrate": "tsx src/scripts/dbMigrate.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "admin:promote": "tsx src/scripts/promoteSuperadmin.ts",
    "e2e:server": "tsx src/scripts/e2eServer.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@rush/shared": "*",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "kysely": "^0.27.5",
    "memorystore": "^1.6.7",
    "multer": "^2.5.0",
    "mysql2": "^3.11.5",
    "nodemailer": "^6.9.16",
    "socket.io": "^4.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.1",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.17.10",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^6.0.2",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.0.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "vitest": "^3.0.0"
  }
}
