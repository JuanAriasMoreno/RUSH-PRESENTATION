      },
      {
       "_type": "UMLTextView",
       "_id": "XpkoSWkiATqStcoq",
       "_parent": {
        "$ref": "7EsiXMhvFQ3zT9L2"
       },
       "font": "Arial;13;0",
       "left": 2164,
       "top": 1600,
       "width": 530,
       "height": 150,
       "text": "Notifications: no table.\nThe 4 email notifications (room invitation, removal from a room,\nquiz added to a room, session started) are sent by the backend at the\nmoment the event happens. Recipients come from existing tables:\nroom_invitation.invited_user_id, the room_membership row (read before\ndeleting it), room_membership of the room, quiz_attempt of the session.\nNo in-app inbox, read status or history is required, so a\nNOTIFICATION entity would add no functionality.",
       "wordWrap": true
      },
      {
       "_type": "UMLTextView",
       "_id": "ZILjIR7tG0s9Mel3",
       "_parent": {
